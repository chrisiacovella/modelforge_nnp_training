[training]
number_of_epochs = 500
remove_self_energies = true
batch_size = {{batch_size}}
lr = {{learning_rate}}
monitor = "val/per_system_energy/rmse"
shift_center_of_mass_to_origin = true
log_norm = false
plot_frequency = 1
gradient_clip_val = 5
# ------------------------------------------------------------ #
[training.experiment_logger]
logger_name = "wandb"
[training.experiment_logger.wandb_configuration]
save_dir = "logs"
project = {{ project }}
group = {{ group }}
log_model = true
job_type = "benchmarking"
tags = {{ tags }}
notes = {{ notes }}
# ------------------------------------------------------------ #
[training.optimizer]
optimizer_name = "AdamW"
betas = [0.9, 0.999]
eps = 1e-8
weight_decay = 0.05
amsgrad = false
maximize = false
# ------------------------------------------------------------ #
[training.lr_scheduler]
scheduler_name = "ReduceLROnPlateau"
frequency = 1
mode = "min"
monitor = "val/per_system_energy/rmse"
factor = 0.5
patience = 5
cooldown = 5
min_lr = 1e-6
threshold = 0.01
threshold_mode = "abs"
interval = "epoch"
# ------------------------------------------------------------ #
[training.loss_parameter]
loss_components = ['per_system_energy', 'per_system_dipole_moment', 'per_atom_charge', 'per_atom_force']
[training.loss_parameter.weight]
per_system_energy = 1
per_system_dipole_moment = {{per_system_dipole_moment_weight}}
per_atom_charge = {{per_atom_charge_weight}}
per_atom_force = {{ per_atom_force_loss_weight }}
# ------------------------------------------------------------ #
#[training.loss_parameter.target_weight]
#per_atom_force = {{ per_atom_force_loss_weight }}

#[training.loss_parameter.mixing_steps]
#per_atom_force= 0.00001

# ------------------------------------------------------------ #
[training.early_stopping]
verbose = true
min_delta = 0.01
patience = 7
# ------------------------------------------------------------ #
[training.splitting_strategy]
name = "random_record_splitting_strategy"
data_split = [{{ data_split_fraction }}, 0.1, 0.1]
seed = {{ dataset_splitting_seed }}
test_seed = {{ test_splitting_seed }}
enforce_sum_to_unity = false

# ------------------------------------------------------------ #